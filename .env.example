# Copy to .env.local and fill in. Find both in Supabase: Project Settings > API Keys.
# If either is missing, the app falls back to the built-in sample (mock) data.
#
# Both values are PUBLIC (they ship to the browser). Use the publishable key
# (sb_publishable_...) or the legacy anon key. NEVER use the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
